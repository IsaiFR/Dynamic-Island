# Normalize source text and keep Windows scripts convenient for local execution.
* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.xaml text eol=lf
*.xml text eol=lf
*.manifest text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf
*.png binary
*.ico binary
