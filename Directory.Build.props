<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>Enrique Isaí Figueroa Rodríguez</Authors>
    <Copyright>Copyright © 2026 Enrique Isaí Figueroa Rodríguez</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Author" Value="$(Authors)" />
    <AssemblyMetadata Include="AuthorEmail" Value="kikefigueroa5a@gmail.com" />
  </ItemGroup>
</Project>
